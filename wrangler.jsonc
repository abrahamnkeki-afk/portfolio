{
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/writing/*"]
  },
  "kv_namespaces": [
